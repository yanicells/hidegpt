{
  "name": "hidegpt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "screenshot": "electron-vite build && HIDEGPT_FAKE=1 HIDEGPT_SCREENSHOT=screenshots electron .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "protocol": "codex app-server generate-ts --experimental --out src/generated/codex",
    "postinstall": "node node_modules/electron/install.js"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^44.1.0",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.3.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
