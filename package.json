{
  "name": "hidegpt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot app.tsx",
    "build": "bun build --compile app.tsx --outfile dist/hidegpt",
    "web:dev": "bun web.ts",
    "screenshot": "bun screenshot.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "protocol": "codex app-server generate-ts --experimental --out src/generated/codex"
  },
  "dependencies": {
    "@gpuix/react": "^0.6.0",
    "react": "^19.2.4"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/react": "^19.2.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18"
  }
}
