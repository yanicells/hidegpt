{
  "name": "hidegpt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "prepare": "node -e \"try{require('child_process').execSync('git config core.hooksPath .githooks',{stdio:'ignore'})}catch{}\"",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "screenshot": "electron-vite build && HIDEGPT_FAKE=1 HIDEGPT_SCREENSHOT=screenshots electron .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives",
    "knip": "knip --no-config-hints",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "pnpm typecheck && pnpm lint && pnpm knip && pnpm test",
    "protocol": "node src/vendor/effect-codex-app-server/scripts/generate.ts",
    "postinstall": "node node_modules/electron/install.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.283",
    "@effect/platform-node": "4.1.2",
    "@opencode-ai/sdk": "^1.19.5",
    "effect": "4.1.2",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "html-url-attributes": "^3.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "vfile": "^6.0.3"
  },
  "devDependencies": {
    "@effect/openapi-generator": "4.1.2",
    "@effect/vitest": "4.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/hast": "^3.0.5",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^44.1.0",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.0.1",
    "knip": "6.45.0",
    "lint-staged": "17.6.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.3.0",
    "vite": "^7.3.6",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@11.7.0"
}
