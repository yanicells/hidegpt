{
  "name": "hidegpt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "prepare": "node -e \"try{require('child_process').execSync('git config core.hooksPath .githooks',{stdio:'ignore'})}catch{}\"",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "node scripts/dist.ts",
    "screenshot": "electron-vite build && HIDEGPT_FAKE=1 HIDEGPT_SCREENSHOT=screenshots electron .",
    "test": "vitest run",
    "typecheck": "effect-tsgo tsrs --noEmit",
    "typecheck:effect-strict": "effect-tsgo tsrs --noEmit -p tsconfig.effect-strict.json",
    "lint": "oxlint --deny-warnings",
    "knip": "knip --no-config-hints",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "pnpm typecheck && pnpm lint && pnpm fmt:check && pnpm knip && pnpm test && pnpm build",
    "protocol": "node src/vendor/effect-codex-app-server/scripts/generate.ts",
    "record:codex": "node --import ./scripts/registerTs.mjs scripts/record-codex-replay.ts",
    "record:claude": "node --import ./scripts/registerTs.mjs scripts/record-claude-replay.ts",
    "postinstall": "node node_modules/electron/install.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.283",
    "@base-ui/react": "1.9.0",
    "@effect/platform-node": "4.1.2",
    "@fontsource-variable/google-sans-flex": "^5.3.2",
    "@fontsource/amatic-sc": "^5.3.0",
    "@fontsource/caladea": "^5.3.0",
    "@fontsource/carlito": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/comfortaa": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/lexend": "^5.3.0",
    "@fontsource/lobster": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/merriweather": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/open-sans": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/pacifico": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@fontsource/spectral": "^5.3.0",
    "@opencode-ai/sdk": "^1.19.5",
    "effect": "4.1.2",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "html-url-attributes": "^3.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "vfile": "^6.0.3"
  },
  "devDependencies": {
    "@effect/openapi-generator": "4.1.2",
    "@effect/tsgo": "0.67.1",
    "@effect/vitest": "4.1.2",
    "@electron/asar": "3.4.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/hast": "^3.0.5",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.7.0",
    "acorn": "8.16.0",
    "electron": "^44.1.0",
    "electron-builder": "26.16.1",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.0.1",
    "knip": "6.45.0",
    "lint-staged": "17.6.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.3.0",
    "vite": "^7.3.6",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@11.7.0"
}
