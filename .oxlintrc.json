{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "out",
    "dist",
    "web-dist",
    "tmp",
    "screenshots",
    "references",
    "node_modules",
    "pnpm-lock.yaml",
    "*.tsbuildinfo",
    "src/vendor/effect-codex-app-server/_generated/**",
    // Vendored from T3 Code as is; its suppression names a rule from T3's own plugin.
    "src/vendor/effect-codex-app-server/test/codex-app-server-mock-peer.ts"
  ],
  "plugins": ["eslint", "oxc", "react", "unicorn", "typescript"],
  "categories": {
    "correctness": "warn",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "oxc/no-accumulating-spread": "error",
    "eslint/no-control-regex": "off",
    "typescript/no-this-alias": "off",
    "unicorn/prefer-add-event-listener": "off",
    "unicorn/prefer-string-starts-ends-with": "off",
    "unicorn/prefer-set-has": "off",
    "unicorn/prefer-array-find": "off",
    "unicorn/no-new-array": "off",
    "unicorn/no-array-reverse": "off",
    "react/no-object-type-as-default-prop": "off",
    "react/jsx-no-constructed-context-values": "off",
    "react/memo-dependencies": "error",
    "react/purity": "error",
    "react/refs": "error",
    "react/exhaustive-effect-dependencies": "error",
    "react/set-state-in-effect": "error",
    "react/immutability": "error",
    "react/no-array-index-key": "error",
    "react/no-unstable-nested-components": "error",
    "react/static-components": "error",
    "react/capitalized-calls": "error",
    "typescript/no-extraneous-class": "error",
    "eslint/no-empty-pattern": "error",
    "eslint/no-new": "error",
    "unicorn/no-useless-spread": "error",
    "eslint/no-unused-vars": [
      "error",
      { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "caughtErrorsIgnorePattern": "^_" }
    ],
    "eslint/no-unsafe-optional-chaining": "error",
    "eslint/no-unneeded-ternary": "error",
    "unicorn/no-useless-fallback-in-spread": "error",
    "unicorn/require-module-specifiers": "error",
    "unicorn/no-array-sort": "off",
    "unicorn/consistent-function-scoping": "off",
    "oxc/no-map-spread": "off",
    "react-in-jsx-scope": "off",
    "react-hooks/exhaustive-deps": "off",
    "eslint/no-shadow": "off",
    "eslint/no-await-in-loop": "off",
    "eslint/no-underscore-dangle": "off",
    "typescript/consistent-return": "off",
    "typescript/no-base-to-string": "off",
    "typescript/no-duplicate-type-constituents": "off",
    "typescript/no-implied-eval": "off",
    "typescript/no-meaningless-void-operator": "off",
    "typescript/no-redundant-type-constituents": "off",
    "typescript/no-unnecessary-boolean-literal-compare": "off",
    "typescript/no-unnecessary-type-conversion": "off",
    "typescript/no-unnecessary-type-arguments": "off",
    "typescript/no-unnecessary-type-assertion": "off",
    "typescript/no-unnecessary-type-parameters": "off",
    "typescript/no-unsafe-type-assertion": "off",
    "typescript/await-thenable": "off",
    "typescript/require-array-sort-compare": "off",
    "typescript/restrict-template-expressions": "off",
    "typescript/unbound-method": "off",
    // ~10 s per run under type-aware linting, and HideGPT declares no enums.
    "typescript/no-unsafe-enum-assignment": "off",
    "typescript/no-floating-promises": "error"
  },
  "overrides": [
    {
      // Vendored from T3 Code, which lints it without type information.
      "files": ["src/vendor/**"],
      "rules": { "typescript/no-misused-spread": "off" }
    }
  ],
  "options": {
    "reportUnusedDisableDirectives": "error",
    "typeAware": true,
    "typeCheck": false
  }
}
